# ============================================================
# MODELO de variáveis de ambiente — Orçamento Inteligente (backend)
# ------------------------------------------------------------
# Este arquivo VAI para o Git. NÃO coloque senhas reais aqui.
# Copie este arquivo para ".env" e preencha com os valores reais:
#
#     cp .env.example .env
#
# O arquivo ".env" é ignorado pelo Git (veja .gitignore).
# ============================================================

# ---------- Aplicação ----------
# Nome exibido na documentação automática do FastAPI
APP_NAME="Orçamento Inteligente"
# Ambiente: "development" (local) ou "production" (servidor)
APP_ENV=development
# DEBUG=True liga logs detalhados; use False em produção
DEBUG=True

# ---------- Banco de dados (PostgreSQL) ----------
DB_USER=orcamento_user
DB_PASSWORD=troque_pela_senha_real
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orcamento_db
